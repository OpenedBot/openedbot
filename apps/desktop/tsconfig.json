{
  "compilerOptions": {
    // Electron's main process and sandboxed preload are loaded as CommonJS
    // (a sandboxed preload cannot be an ES module at all), so the whole
    // project emits CJS. node16 resolves a package without "type": "module"
    // as CJS, which is what we want, and keeps the "module" and
    // "moduleResolution" options consistent (bundler needs an ES module target).
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "node16",
    "moduleResolution": "node16",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
