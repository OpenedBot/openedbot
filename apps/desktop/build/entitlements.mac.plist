<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hardened runtime entitlements of openedbot.app (Developer ID build,
  electron-builder.developer-id.yml). V8 needs JIT and writable executable
  memory; nothing else. No disable-library-validation: every framework and
  helper is re-signed with the same Team ID, so library validation passes.
  No camera, microphone or Apple Events: the shell refuses those permissions
  (src/main/window.ts, CONSOLE_PERMISSIONS).
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
  </dict>
</plist>
