[Unit]
Description=Hermes automatic host-access rollback
After=network.target ssh.service
ConditionPathExists=/var/lib/hermes-host-hardening/active
StartLimitIntervalSec=0

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
# The rollback reads markers and backups only, never the tool's JSON state.
ExecStart=/usr/local/lib/hermes-setup/edge-setup internal rollback-access
Restart=on-failure
RestartSec=10s
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
