########################################################################
# openedbot local development — .env.example.
# The whole monorepo: API, worker, PWA, staff backoffice, Makefile and shell scripts.
#
# `make setup` writes DEV_HERMES_URL from its profile: MODE=fake (default) points
# at tests/fake-hermes, MODE=external at your runtime. No lab URL is defaulted.
#
# Generated from platform/config/src/env-schema.ts by `make env-template`.
# Edit the schema, never this file; `make test-unit` fails when they differ.
########################################################################

########################################################################
####################### SHARED  —  API + WORKER ########################
########################################################################

# Comma-separated bundle identifiers a device may register with; each one is also the apns-topic of its deliveries.
APNS_BUNDLE_IDS=

# Origin replacing both Apple APNs hosts, for the local fake (make fake-apns, http://127.0.0.1:18793). http: only toward loopback; refused in production.
APNS_HOST_OVERRIDE=

# APNs token-auth key identifier (10 characters) of the .p8 key; API and worker. The four APNS_* values are set together or not at all; all empty disables iOS push (GET /api/push/apns/config answers enabled: false).
APNS_KEY_ID=

# APNs .p8 signing key (EC P-256, PKCS#8 PEM with \n escapes or its base64 body); secret manager in production, never committed. Locally, bun tests/fake-apns/server.ts --dev-key prints a throwaway key for the fake.
APNS_PRIVATE_KEY=

# Apple Developer team identifier (10 characters), issuer of the APNs provider JWT.
APNS_TEAM_ID=

# `file` stores attachments under BLOB_FILE_ROOT; production requires `r2`.
BLOB_DRIVER=file

# Directory of the `file` blob driver; the API and the worker must share it.
BLOB_FILE_ROOT=.data/blobs

# Seed-only Hermes gateway (`make db-seed`), written by the fake profile (http://127.0.0.1:18642); optional otherwise. No lab default.
DEV_HERMES_URL=

# Explicit host:port list reachable over plaintext HTTP, development only; never a wildcard nor a CIDR. Must stay empty in production.
HERMES_ALLOW_INSECURE_ORIGINS=

# Environment: development, test, production or preprod. production and preprod enable every startup guard; preprod only changes the deployment label (alerts, connectors, sign-in options).
OPENEDBOT_ENV=development

# Cloudflare account that hosts openedbot-managed tunnels for direct runtimes, as cloudflare://<api-token>@<account-id>/<zone-id>[?suffix=rt.openedbot.app]. The token is scoped to Cloudflare Tunnel Edit, Access Apps/Policies Edit, Access Service Tokens Edit and DNS Edit on the managed zone only; suffix is the DNS suffix of the managed hostnames, openedbot-<hex>.<suffix> (default rt.openedbot.app). Empty: the managed path stays hidden.
OPENEDBOT_MANAGED_TUNNEL_URL=

# VAPID private key (32 bytes, URL-safe base64). Generate with bunx web-push generate-vapid-keys from apps/worker. Never commit a real value.
PUSH_VAPID_PRIVATE_KEY=

# VAPID public key (uncompressed P-256 point, URL-safe base64) of the Web Push application server; API and worker. Absent in development disables push. Generate with bunx web-push generate-vapid-keys from apps/worker.
PUSH_VAPID_PUBLIC_KEY=

# VAPID contact URI of the application server: mailto: or https: only.
PUSH_VAPID_SUBJECT=

# 32 bytes in base64 encrypting runtime bearers at rest. Generated by `make setup`; never commit a real value.
RUNTIME_TOKEN_ENCRYPTION_KEY=

########################################################################
########################### API  —  apps/api ###########################
########################################################################

# PostgreSQL DSN of the API role (RLS tenant role, never the migrator).
API_DATABASE_URL=postgres://openedbot_api:openedbot_api_dev@127.0.0.1:5432/openedbot

# Ed25519 seed (32 bytes, base64) signing creation-audit verdicts so a retained verdict can be re-verified offline. Generated by `make setup`; absent outside production, the API signs with an ephemeral key and marks its verdicts as such.
AUDIT_VERDICT_SIGNING_KEY=

# `disabled` (development default): audit anchors and verdicts live in PostgreSQL only. `r2` (mandatory in production): each anchor and verdict is also written once to a dedicated, retention-locked R2 bucket with the AUDIT_WORM_* credentials below.
AUDIT_WORM_MODE=disabled

# Development only: owner DSN used by POST /api/onboarding/reset {"scope":"full"}; empty leaves the full wipe to make db-reset-keep-users.
DEV_RESET_DATABASE_URL=

# Opens the assisted Tailscale Funnel publication. The card stays visible but disabled while unset; the API answers TAILSCALE_FUNNEL_UNAVAILABLE.
OPENEDBOT_TAILSCALE_FUNNEL_ENABLED=false

# Dernière release stable publiée du connecteur (vX.Y.Z, par exemple v0.2.0), facultative. Vide : aucune mise à jour proposée.
RUNTIME_CONNECTOR_LATEST_VERSION=

# Version stable minimale du connecteur (vX.Y.Z), facultative. Une version inférieure est signalée comme obsolète sans refuser la session. Vide : aucun seuil minimal.
RUNTIME_CONNECTOR_MIN_VERSION=

# Web interface for reviewing messages sent locally (Mailpit by default). Informational only: the API never calls it and only gives the link to the staff backoffice. Ignored in production.
TRANSACTIONAL_EMAIL_MAILBOX_URL=http://127.0.0.1:8025

########################################################################
######################## WORKER  —  apps/worker ########################
########################################################################

# Sender address of transactional emails. Required as soon as a transport is set, in every environment: the worker refuses to start without it.
TRANSACTIONAL_EMAIL_FROM=no-reply@openedbot.local

# SMTP URL for transactional email (smtp://127.0.0.1:1025 for local Mailpit, the dev default). Exclusive of the other three transports; smtps:// and STARTTLS are accepted.
TRANSACTIONAL_EMAIL_SMTP_URL=smtp://127.0.0.1:1025

# PostgreSQL DSN of the worker role.
WORKER_DATABASE_URL=postgres://openedbot_worker:openedbot_worker_dev@127.0.0.1:5432/openedbot

########################################################################
###################### WEB  —  apps/console (PWA) ######################
########################################################################

# Account seeded by `make db-seed`; in OPENEDBOT_ENV=development /login pre-fills it.
E2E_EMAIL=dev@openedbot.local

# Password of the seeded development accounts (dev@openedbot.local; development autofill only). Generated at random by `make setup` or the first `make db-seed`; never commit a value.
E2E_PASSWORD=

# Canonical origin of the PWA. Billing returns and enrolment links point here, and it is always allowed by CORS.
WEB_APP_URL=http://localhost:1420

########################################################################
############ ADMIN  —  staff backoffice (external plug-in) #############
########################################################################

# Staff backoffice origin (external plug-in). Auto-included in CORS; HTTPS required in production.
ADMIN_PUBLIC_URL=http://localhost:1421

########################################################################
######################### SCRIPTS AND MAKEFILE #########################
########################################################################

# Seed-only bearer of DEV_HERMES_URL, written by the fake profile (fake-hermes-token); optional otherwise.
DEV_HERMES_TOKEN=

# Name of the shared dev-infra PostgreSQL container used by db.sh; never created by this repository.
OPENEDBOT_POSTGRES_CONTAINER=infra-postgres
