{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "moduleDetection": "force",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable",
      "DOM.AsyncIterable"
    ]
  },
  "include": [
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "apps/console/scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules"
  ]
}
